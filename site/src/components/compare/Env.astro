---
// The Docker Compose panel's .env: each key the snippet's "# edit .env:" line names, under the comment line
// above it in deploy/compose/.env.example. A key the file doesn't have fails the build.
import example from "../../../../deploy/compose/.env.example?raw";
import { snippet, t } from "../../lib/copy";
import { highlight } from "../../lib/highlight";

const lines = example.split("\n");
const keys = /^# edit \.env: (.+)$/m.exec(snippet("home.install.snippet.compose").text)?.[1]?.split(", ") ?? [];
const text = keys.map((key) => {
  const at = lines.findIndex((l) => l.startsWith(`${key}=`));
  if (at < 1) throw new Error(`deploy/compose/.env.example has no ${key}= under a comment`);
  return `${lines[at - 1]}\n${lines[at]}`;
});
if (!text.length) throw new Error('The Docker Compose snippet has no "# edit .env:" line');
---
<div class="env">
  <div class="code__bar"><span class="code__lang" id="env-h">{t("compare.selfhost.env")}</span></div>
  <pre class="code__pre" tabindex="0" aria-labelledby="env-h"><code set:html={highlight(text.join("\n\n"), "sh")} /></pre>
</div>
