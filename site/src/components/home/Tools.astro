---
// The MCP tools in four groups (Read and Send, then Organize and Alerts, their heads level), each with its risk
// hints from the server's pinned tools list.
import Code from "./Code.astro";
import Head from "./Head.astro";
import Hints from "./Hints.astro";
import Icon from "../Icon.astro";
import SiteLink from "../SiteLink.astro";
import { t } from "../../lib/copy";
import { toolCodeRuns } from "../../lib/tools";
import readme from "../../../../README.md?raw";

const GROUPS: [string, number[]][] = [
  ["read", [0, 1, 2, 12]],
  ["send", [3, 4, 16, 17]],
  ["organize", [5, 6, 7, 8]],
  ["alerts", [9, 10, 11, 13, 14, 15]],
];
const codeRuns = toolCodeRuns(readme);
---
<section class="sec" id="tools" aria-labelledby="tools-h">
  <div class="wrap">
    <Head id="tools-h" kicker="home.tools.kicker" title="home.tools.title" lede="home.tools.lead" />
    <div class="tools">
      {GROUPS.map(([g, ids]) => (
        <section class="tgrp" aria-labelledby={`tg-${g}`}>
          <h3 class="sub" id={`tg-${g}`}>{t(`home.tools.groups.${g}`)}<span>{ids.length}</span></h3>
          <ul class="tgrp__list">
            {ids.map((n) => (
              <li class="tool">
                <p class="tool__h"><code class="tag tag--plain ref__name">{t(`home.tools[${n}].name`)}</code><Hints name={t(`home.tools[${n}].name`)} /></p>
                <p class="tool__t"><Code id={`home.tools[${n}].desc`} runs={codeRuns(t(`home.tools[${n}].name`))} /></p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <div class="sec__foot">
      <p class="note"><Icon name="info" /><span>{t("home.tools.after")}</span></p>
      <SiteLink id="home.tools.link" class="tlink" after="arrow" ext={false} />
    </div>
  </div>
</section>
