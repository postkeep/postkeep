---
// Home (/): the hero with the agent window and its call log, then install, tools, works with, self-host,
// open source (with postkeep Cloud) and the closing line.
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Closing from "../components/home/Closing.astro";
import Hero from "../components/home/Hero.astro";
import Install from "../components/home/Install.astro";
import OpenSource from "../components/home/OpenSource.astro";
import SelfHost from "../components/home/SelfHost.astro";
import Tools from "../components/home/Tools.astro";
import Works from "../components/home/Works.astro";
import { t } from "../lib/copy";
import "../styles/home.css";
---
<Base
  title={t("meta.home.title")}
  description={t("meta.home.description")}
  og={{ title: t("meta.og.title"), description: t("meta.og.description") }}
  page="home"
>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <Install />
    <Tools />
    <Works />
    <SelfHost />
    <OpenSource />
    <Closing />
  </main>
  <SiteFooter />
</Base>
