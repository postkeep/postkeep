# Copy to .env and fill in. Keep .env private (chmod 600 .env).

# Public HTTPS origin users and MCP clients reach, without a path.
PUBLIC_URL=https://mail.example.com

# 32-byte master key that encrypts stored credentials.
# Generate one with:
#   docker run --rm postkeep/postkeep generate-key
# Back it up: without it, stored passwords can't be decrypted.
MASTER_KEY=

# Optional: comma-separated email addresses allowed to connect.
ALLOWED_EMAILS=

# Domain for the optional Caddy profile (usually PUBLIC_URL's host).
DOMAIN=mail.example.com

# Image tag to run (latest, or a version such as 0.3.3).
IMAGE_TAG=latest

# Header with the real client IP, set by the proxy in front of the server:
# X-Forwarded-For for the bundled Caddy profile. Leave empty without a proxy.
CLIENT_IP_HEADER=

# Any other setting from docs/configuration.md goes here under its POSTKEEP_
# name, such as POSTKEEP_MICROSOFT_CLIENT_ID=... Put a value that holds a $
# in single quotes.
